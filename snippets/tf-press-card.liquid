{% comment %}
  TF Press Card
  Renders a single press article card from a press_article metaobject.
  Usage: {% render 'tf-press-card', article: article %}
{% endcomment %}

<a
  href="{{ article.external_url.value }}"
  target="_blank"
  rel="noopener noreferrer"
  class="tf-press-card no-underline text-inherit flex flex-col"
>
  {% if article.cover_image.value %}
    <div class="relative w-full aspect-[3/4] overflow-hidden bg-[#f4f4f4]">
      <!-- Blurred placeholder -->
      <img
        src="{{ article.cover_image.value | image_url: width: 50 }}"
        alt="{{ article.title.value | escape }}"
        class="absolute inset-0 w-full h-full object-cover blur-xl scale-110 transition-opacity duration-500"
        loading="eager"
        data-placeholder="true"
      >
      <!-- Full resolution image -->
      <img
        src="{{ article.cover_image.value | image_url: width: 800 }}"
        srcset="
          {{ article.cover_image.value | image_url: width: 400 }} 400w,
          {{ article.cover_image.value | image_url: width: 600 }} 600w,
          {{ article.cover_image.value | image_url: width: 800 }} 800w,
          {{ article.cover_image.value | image_url: width: 1000 }} 1000w
        "
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
        alt="{{ article.title.value | escape }}"
        class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-500"
        loading="lazy"
        decoding="async"
        data-press-image="true"
      >
    </div>
  {% else %}
    <div class="w-full aspect-[3/4] bg-[#eee]"></div>
  {% endif %}

  <h3 class="font-sm leading-[1.3] font-medium m-0 mt-3">{{ article.title.value }}</h3>
  <div class="flex text-[16px] leading-[1.3] text-[#6F6F6F] mt-3 gap-[20px]">
    <span>{{ article.magazine_name.value }}</span>
    {% if article.publication_date.value != blank %}
      <span>{{ article.publication_date.value | date: "%b %Y" }}</span>
    {% endif %}
  </div>
</a>
