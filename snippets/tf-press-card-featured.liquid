{% comment %}
  TF Press Card — Featured (subgrid layout)
  Parent <a> uses subgrid; image and info are separate grid children.
  On mobile: stacks vertically. On md+: image left, info right.
  Usage: {% render 'tf-press-card-featured', article: article %}
{% endcomment %}

<a
  href="{{ article.external_url.value }}"
  target="_blank"
  rel="noopener noreferrer"
  class="tf-press-card col-span-2 md:col-span-2 lg:col-span-3 2xl:col-span-4 no-underline text-inherit"
  style="display: grid; grid-template-columns: subgrid;"
>
  {% if article.cover_image.value %}
    <div class="relative overflow-hidden bg-[#f4f4f4] col-span-2 md:col-span-1 lg:col-span-2 2xl:col-span-3" style="aspect-ratio: 3/4;">
      <!-- Blurred placeholder -->
      <img
        src="{{ article.cover_image.value | image_url: width: 50 }}"
        alt="{{ article.title.value | escape }}"
        class="absolute inset-0 w-full h-full object-cover blur-xl scale-110 transition-opacity duration-500"
        loading="eager"
        data-placeholder="true"
      >
      <!-- Full resolution image -->
      <img
        src="{{ article.cover_image.value | image_url: width: 800 }}"
        srcset="
          {{ article.cover_image.value | image_url: width: 400 }} 400w,
          {{ article.cover_image.value | image_url: width: 600 }} 600w,
          {{ article.cover_image.value | image_url: width: 800 }} 800w,
          {{ article.cover_image.value | image_url: width: 1000 }} 1000w
        "
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
        alt="{{ article.title.value | escape }}"
        class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-500"
        loading="lazy"
        decoding="async"
        data-press-image="true"
      >
    </div>
  {% else %}
    <div class="bg-[#eee] col-span-2 md:col-span-1 lg:col-span-2 2xl:col-span-3" style="aspect-ratio: 3/4;"></div>
  {% endif %}

  <div class="col-span-2 md:col-span-1 lg:col-span-1 xl:col-span-1 flex flex-col justify-between">
    <div>
      <h3 class="font-sm leading-[1.3] font-medium m-0 mt-[14px] md:mt-0">{{ article.title.value }}</h3>
      <div class="flex text-[20px] leading-[1.3] text-[#6F6F6F]" style="margin-top: 14px; gap: 20px;">
        <span>{{ article.magazine_name.value }}</span>
        {% if article.publication_date.value != blank %}
          <span>{{ article.publication_date.value | date: "%B %Y" }}</span>
        {% endif %}
      </div>
    </div>
    <span class="text-[20px] leading-[1.3]">Read &#8599;</span>
  </div>
</a>
