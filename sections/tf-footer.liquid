{% comment %} THE FALL – Footer {% endcomment %}

<footer class="bg-[#252525] text-[#f6f5f1] py-7 md:py-0 md:h-[100px]">
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 xl:grid-cols-8 grid-rows-1 px-[20px] md:px-[30px] lg:px-[50px] gap-[15px] md:gap-[20px] lg:gap-[40px] md:pt-26">

        {% comment %} Mobile Layout - Full Width Stack {% endcomment %}
        <div class="col-span-2 md:hidden flex flex-col gap-4">
            {% comment %} Copyright {% endcomment %}
            <div class="font-xs">
                ©The Fall Bridal Ltd. 2020-{{ 'now' | date: '%Y' }}
            </div>

            {% comment %} Menu Links {% endcomment %}
            <nav class="w-full">
                <ul class="flex flex-wrap gap-3 list-none leading-normal" role="list">
                    {% for link in section.settings.menu.links %}
                        <li class="mb-0">
                            <a class="font-xs text-white no-underline hover:underline whitespace-nowrap" href="{{ link.url }}">
                                {{ link.title }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </nav>

            {% comment %} Social Icons {% endcomment %}
            <ul class="flex gap-4 list-none leading-normal">
                <li>
                    <a href="https://www.tiktok.com/@thefallbride" class="flex items-center hover:text-gray-300 transition">
                        {% render 'icon-tiktok' %}
                    </a>
                </li>
                <li>
                    <a href="https://uk.pinterest.com/thefallbrideldn/" class="flex items-center hover:text-gray-300 transition">
                        {% render 'icon-pinterest' %}
                    </a>
                </li>
                <li>
                    <a href="https://www.instagram.com/thefallbride" class="flex items-center hover:text-gray-300 transition">
                        {% render 'icon-instagram' %}
                    </a>
                </li>
            </ul>
        </div>

        {% comment %} Desktop Layout - Original Grid {% endcomment %}
        {% comment %} Logo - left side, 3 columns on desktop {% endcomment %}
        <div class="hidden md:block col-span-2 lg:col-span-3 xl:col-span-3 text-[#f6f5f1]">
            <div class="font-xs mt-4">
                ©The Fall Bridal Ltd. 2020-{{ 'now' | date: '%Y' }}
            </div>
        </div>

        {% comment %} Menu - starts at column 5 on desktop {% endcomment %}
        <nav class="hidden md:flex col-span-4 md:col-start-3 md:justify-self-start lg:col-start-4 xl:col-start-5 justify-between w-full mt-1">
            <ul class="flex flex-wrap gap-4 lg:gap-7 list-none leading-normal" role="list">
                {% for link in section.settings.menu.links %}
                    <li class="mb-0">
                        <a class="font-xs text-white no-underline hover:underline whitespace-nowrap" href="{{ link.url }}">
                            {{ link.title }}
                        </a>
                    </li>
                {% endfor %}
            </ul>
            <ul class="flex gap-4 list-none leading-normal">
                <li>
                    <a href="https://www.tiktok.com/@thefallbride" class="flex items-center hover:text-gray-300 transition">
                        {% render 'icon-tiktok' %}
                    </a>
                </li>
                <li>
                    <a href="https://uk.pinterest.com/thefallbrideldn/" class="flex items-center hover:text-gray-300 transition">
                        {% render 'icon-pinterest' %}
                    </a>
                </li>
                <li>
                    <a href="https://www.instagram.com/thefallbride" class="flex items-center hover:text-gray-300 transition">
                        {% render 'icon-instagram' %}
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</footer>

{% schema %}
{
  "name": "TF • Footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer Menu",
      "default": "footer"
    }
  ],
  "presets": [{ "name": "TF • Footer" }]
}
{% endschema %}