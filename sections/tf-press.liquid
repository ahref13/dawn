{% comment %} TF • Press (Homepage Section) {% endcomment %}

{{ 'tf-press.css' | asset_url | stylesheet_tag }}

<section class="px-[20px] md:px-[30px] lg:px-[50px] flex flex-col" id="tf-press-home" style="margin-top: 130px;">
  <!-- Header -->
  <div class="mb-16 grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 xl:grid-cols-8 gap-[15px] md:gap-[20px] lg:gap-[40px] pb-8">
    <div class="col-span-2 md:col-span-2 lg:col-span-3 xl:col-span-4">
      <h2 class="font-sm uppercase">{{ section.settings.heading }}</h2>
    </div>
    <div class="col-span-2 md:col-span-2 lg:col-span-3 xl:col-span-4">
      <div class="font-sm leading-tight">{{ section.settings.description }}</div>
    </div>
  </div>

  {% comment %}{% comment %} Press grid — same as featured section on press list page {% endcomment %}{% endcomment %}
  {% comment %}<div class="w-full grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 2xl:grid-cols-8 auto-rows-min gap-[15px] md:gap-[20px] lg:gap-[40px] pb-[60px]">{% endcomment %}
    {% comment %}{% assign count = 0 %}{% endcomment %}
    {% comment %}{% assign max = section.settings.max_items %}{% endcomment %}
    {% comment %}{% for article in shop.metaobjects.press_article.values %}{% endcomment %}
      {% comment %}{% if article.featured_homepage.value == true or article.featured_homepage.value == "true" %}{% endcomment %}
        {% comment %}{% if count < max %}{% endcomment %}
          {% comment %}{% render 'tf-press-card-featured', article: article %}{% endcomment %}
          {% comment %}{% assign count = count | plus: 1 %}{% endcomment %}
        {% comment %}{% endif %}{% endcomment %}
      {% comment %}{% endif %}{% endcomment %}
    {% comment %}{% endfor %}{% endcomment %}
{% comment %}{% endcomment %}
    {% comment %}{% comment %} Full archive link — inside the grid as a card-sized item {% endcomment %}{% endcomment %}
    {% comment %}{% if section.settings.archive_url != blank %}{% endcomment %}
      {% comment %}<div class="col-span-2 md:col-span-2 lg:col-span-3 2xl:col-span-4 no-underline text-inherit" style="display: grid; grid-template-columns: subgrid;">{% endcomment %}
        {% comment %}<div class="col-span-2 md:col-span-1 lg:col-span-2 2xl:col-span-3"></div>{% endcomment %}
        {% comment %}<div class="col-span-2 md:col-span-1 lg:col-span-1 xl:col-span-1 flex flex-col justify-end">{% endcomment %}
          {% comment %}<a href="{{ section.settings.archive_url }}" class="text-[16px] leading-none no-underline text-black">{% endcomment %}
            {% comment %}<span class="border-b border-black">{{ section.settings.archive_label }}</span>{% endcomment %}
          {% comment %}</a>{% endcomment %}
        {% comment %}</div>{% endcomment %}
      {% comment %}</div>{% endcomment %}
    {% comment %}{% endif %}{% endcomment %}
  {% comment %}</div>{% endcomment %}
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var pressImages = document.querySelectorAll('#tf-press-home [data-press-image]');
    pressImages.forEach(function (img) {
      if (img.complete) {
        handlePressImageLoad(img);
      } else {
        img.addEventListener('load', function () {
          handlePressImageLoad(img);
        });
      }
    });

    function handlePressImageLoad(img) {
      img.style.opacity = '1';
      var placeholder = img.previousElementSibling;
      if (placeholder && placeholder.hasAttribute('data-placeholder')) {
        setTimeout(function () {
          placeholder.style.opacity = '0';
        }, 100);
      }
    }
  });
</script>

{% schema %}
{
  "name": "TF • Press",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "PRESS"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "The Fall has been quietly reshaping the bridal conversation. A selection of press that captures our approach to modern dressing, independent retail, and the contemporary bride."
    },
    {
      "type": "range",
      "id": "max_items",
      "min": 3,
      "max": 6,
      "step": 3,
      "label": "Maximum items to show",
      "default": 6
    },
    {
      "type": "url",
      "id": "archive_url",
      "label": "Full archive page URL"
    },
    {
      "type": "text",
      "id": "archive_label",
      "label": "Archive link text",
      "default": "Full Press Archive"
    }
  ],
  "presets": [
    {
      "name": "TF • Press"
    }
  ]
}
{% endschema %}
