{% comment %} THE FALL – Full-bleed hero with animated logo {% endcomment %}
<section class="relative min-h-screen w-full" id="tf-hero-section">
  {% if section.settings.image != blank %}
    {{ section.settings.image
    | image_url: width: 3000
    | image_tag:
    class: 'absolute inset-0 w-full h-screen max-w-none object-cover',
    style: 'height: 100vh !important;',
    loading: 'eager',
    fetchpriority: 'high',
    decoding: 'async',
    widths: '1080, 1440, 1920, 2400, 3000',
    sizes: '(max-aspect-ratio: 2/3) 300vw, (max-aspect-ratio: 1/1) 200vw, 100vw' }}
  {% endif %}

  {% comment %} Animated logo - only for first time or refresh {% endcomment %}
  <div id="tf-animated-logo-container" class="fixed inset-0 pointer-events-none z-50 mix-blend-difference flex items-center justify-center">
    {% if section.settings.title_image %}
      {{ section.settings.title_image
      | image_url: width: 800
      | image_tag:
      class: 'h-auto block',
      style: 'max-width: 55vw; width: 100%;',
      id: 'tf-animated-logo',
      alt: section.settings.title_image_alt | escape }}
    {% endif %}
  </div>

  {% comment %} Static logo - shows after animation or on return to home {% endcomment %}
  <div id="tf-static-logo-container" class="absolute inset-0 pointer-events-none z-40 mix-blend-difference flex items-center justify-center opacity-0">
    {% if section.settings.title_image %}
      {{ section.settings.title_image
      | image_url: width: 800
      | image_tag:
      class: 'h-auto block',
      style: 'max-width: 55vw; width: 100%;',
      id: 'tf-static-logo',
      alt: section.settings.title_image_alt | escape }}
    {% endif %}
  </div>
</section>

<style>
  #tf-animated-logo-container {
    will-change: transform, opacity;
  }
  #tf-animated-logo {
    will-change: transform;
    transform-origin: center center;
  }
  #tf-static-logo-container {
    transition: opacity 0.6s ease-out;
  }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

<script>

  window.history.scrollRestoration = "manual";
  // Force scroll to top on homepage refresh BEFORE animation loads
  const nav = performance.getEntriesByType("navigation")[0];
  const isRefresh = nav && nav.type === "reload";

  const isHomePage =
          window.location.pathname === "/" ||
          window.location.pathname === "/index" ||
          window.location.pathname === "";

  if (isHomePage && isRefresh) {
    // Prevent browser from restoring scroll position
    window.history.scrollRestoration = "manual";

    // Scroll immediately to top (before DOMContentLoaded)
    window.scrollTo(0, 0);
  }

  document.addEventListener('DOMContentLoaded', () => {
    const animatedLogoContainer = document.getElementById('tf-animated-logo-container');
    const animatedLogo = document.getElementById('tf-animated-logo');
    const staticLogoContainer = document.getElementById('tf-static-logo-container');
    const header = document.getElementById('tf-main-header');
    const headerLogo = header?.querySelector('a[aria-label="{{ shop.name }}"] img, a[aria-label="{{ shop.name }}"] span');

    if (!animatedLogo) {
      console.warn('Animated logo not found');
      return;
    }

    const path = window.location.pathname;
    const isHome =
            path === '/' ||
            path === '/index' ||
            path === '';

    const navEntry = performance.getEntriesByType('navigation')[0];
    const navType = navEntry ? navEntry.type : 'navigate';
    const isReload = navType === 'reload';

    const hasAnimationPlayed = sessionStorage.getItem('tf-hero-animation-played') === 'true';

    // 🧭 Not on homepage → just hide animated logo, show header, do nothing fancy
    if (!isHome) {
      if (animatedLogoContainer) animatedLogoContainer.style.opacity = '0';
      if (staticLogoContainer) staticLogoContainer.style.opacity = '0';
      if (header) header.style.opacity = '1';
      return;
    }

    // 🧭 On homepage:

    // ✅ Case 1: Animation has already played and this is NOT a reload
    // → User is coming back or navigating to home → skip animation
    if (hasAnimationPlayed && !isReload) {
      if (animatedLogoContainer) animatedLogoContainer.style.opacity = '0';
      if (staticLogoContainer) staticLogoContainer.style.opacity = '1';
      if (header) header.style.opacity = '1';
      return;
    }

    // ✅ Case 2: First visit or reload
    // On reload we explicitly clear the "played" flag so animation replays
    if (isReload) {
      sessionStorage.removeItem('tf-hero-animation-played');
    }

    // Initial states for animation
    if (staticLogoContainer) staticLogoContainer.style.opacity = '0';
    if (animatedLogoContainer) animatedLogoContainer.style.opacity = '1';
    if (header) header.style.opacity = '0';

    if (!header || !headerLogo) {
      return;
    }

    gsap.registerPlugin(ScrollTrigger);

    const getHeaderLogoRect = () => headerLogo.getBoundingClientRect();
    const getLogoRect = () => animatedLogo.getBoundingClientRect();

    const setupAnimation = () => {
      const headerRect = getHeaderLogoRect();
      const logoRect = getLogoRect();

      const centerX = window.innerWidth / 2;
      const centerY = window.innerHeight / 2;

      // Scale based on height (hero logo is THE FALL, header logo is THE FALL / NY)
      const targetScale = headerRect.height / logoRect.height;

      // After scaling, the logo's rendered width will be:
      const scaledWidth = logoRect.width * targetScale;

      // Align left edge of scaled logo with left edge of header logo
      const deltaX = headerRect.left + scaledWidth / 2 - centerX;
      const deltaY = headerRect.top + headerRect.height / 2 - centerY;

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: 'body',
          start: '300px top',
          end: '800px top',
          scrub: 1,
          invalidateOnRefresh: true,

          // When animation completes while scrolling DOWN
          onLeave: self => {
            sessionStorage.setItem('tf-hero-animation-played', 'true');

            // show static + header
            if (staticLogoContainer) staticLogoContainer.style.opacity = '1';
            if (header) header.style.opacity = '1';

            // hide animation logo completely
            animatedLogoContainer.style.opacity = '0';
            animatedLogoContainer.style.display = 'none';

            self.disable(); // ⛔ prevent rewinding forever
          },

          // Prevent backward animation on scroll-up or scroll restore
          onEnterBack: self => {
            animatedLogoContainer.style.opacity = '0';
            animatedLogoContainer.style.display = 'none';
            self.disable();
          }
        }
      });

      // Only animate animated logo & its movement
      tl.to(animatedLogoContainer, {
        x: deltaX,
        y: deltaY,
        ease: 'power2.inOut'
      }, 0);

      tl.to(animatedLogo, {
        scale: targetScale,
        ease: 'power2.inOut'
      }, 0);

      tl.to(animatedLogoContainer, {
        opacity: 0,
        ease: 'power2.in'
      }, 0.8);

      return tl;
    };

    let timeline = setupAnimation();

    // Recalculate on resize
    let resizeTimeout;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        if (timeline) timeline.kill();
        ScrollTrigger.getAll().forEach(tr => tr.kill());
        timeline = setupAnimation();
        ScrollTrigger.refresh();
      }, 250);
    });
  });
</script>

{% schema %}
{
  "name": "TF • Hero full-bleed",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "image_picker", "id": "title_image", "label": "Title image (logo)" },
    { "type": "text", "id": "title_image_alt", "label": "Image alt text", "default": "Logo" }
  ],
  "presets": [
    { "name": "TF • Hero full-bleed" }
  ]
}
{% endschema %}
