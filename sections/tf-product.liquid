{% comment %} THE FALL – Product Template - Tailwind Grid {% endcomment %}

<section class="min-h-screen w-full relative pt-[130px] pb-[60px]">
  <!-- Content Grid -->
  <div class="relative grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 xl:grid-cols-8 auto-rows-min px-[20px] md:px-[30px] lg:px-[50px] gap-[15px] md:gap-[20px] lg:gap-[40px]">
    <!-- Images Section - Columns 1-4 on xl -->
    <div class="col-span-2 md:col-span-2 lg:col-span-3 xl:col-span-4 flex flex-col gap-4">
      <!-- Main Image -->
      {% assign v = product.selected_or_first_available_variant %}

      <div class="w-full bg-[#f5f5f5] relative overflow-hidden">
        <div class="relative w-full">
          {% if product.featured_image %}
            <!-- Blurred placeholder for main image -->
            <img
              src="{{ product.featured_image | image_url: width: 50 }}"
              alt="{{ product.title | escape }}"
              class="w-full h-auto block blur-xl scale-110 transition-opacity duration-500"
              loading="eager"
              data-main-placeholder="true"
            >

            <!-- Full resolution main image -->
            <img
              id="main-product-image"
              src="{{ product.featured_image | image_url: width: 900 }}"
              srcset="
                {{ product.featured_image | image_url: width: 600 }} 600w,
                {{ product.featured_image | image_url: width: 900 }} 900w,
                {{ product.featured_image | image_url: width: 1200 }} 1200w,
                {{ product.featured_image | image_url: width: 1600 }} 1600w,
                {{ product.featured_image | image_url: width: 2000 }} 2000w
              "
              sizes="(max-width: 768px) 100vw, 50vw"
              alt="{{ product.title | escape }}"
              class="absolute inset-0 w-full h-auto block object-cover opacity-0 transition-opacity duration-500"
              loading="eager"
              decoding="async"
              data-main-image="true"
            >
          {% endif %}

          {% if v.compare_at_price > v.price %}
            <div class="absolute top-3 right-3 z-50 px-3 py-1 text-[12px] uppercase tracking-[0.08em] bg-black text-white">
              On sale
            </div>
          {% endif %}
        </div>
      </div>

      <!-- Thumbnail Images -->
      {% if product.images.size > 1 %}
        <div class="flex gap-4 flex-wrap">
          {% for image in product.images %}
            <div class="relative w-20 h-20 max-md:w-[60px] max-md:h-[60px] overflow-hidden bg-gray-100 cursor-pointer">
              <!-- Blurred placeholder for thumbnail -->
              <img
                src="{{ image | image_url: width: 20 }}"
                alt="{{ product.title | escape }}"
                class="absolute inset-0 w-full h-full object-cover blur-md scale-110 transition-opacity duration-300"
                loading="eager"
                data-thumb-placeholder="true"
              >

              <!-- Full thumbnail -->
              <img
                src="{{ image | image_url: width: 200 }}"
                alt="{{ product.title | escape }}"
                class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-300 {% if forloop.first %}thumb-active{% endif %}"
                data-src="{{ image | image_url: width: 900 }}"
                data-srcset="
                  {{ image | image_url: width: 600 }} 600w,
                  {{ image | image_url: width: 900 }} 900w,
                  {{ image | image_url: width: 1200 }} 1200w,
                  {{ image | image_url: width: 1600 }} 1600w,
                  {{ image | image_url: width: 2000 }} 2000w
                "
                data-placeholder-src="{{ image | image_url: width: 50 }}"
                data-thumb-image="true"
                loading="lazy"
              >
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- Product Info Section - Columns 5-8 on xl -->
    <div class="col-span-2 md:col-span-2 md:col-start-3 lg:col-span-2 lg:col-start-4 xl:col-span-3 xl:col-start-5 max-md:static md:sticky md:top-[130px] md:self-start">
      <h1 class="font-base font-normal leading-[1.2] m-0 md:mb-[120px]">{{ product.title }}</h1>

      {% assign v = product.selected_or_first_available_variant %}

      <div class="font-sm font-normal md:mb-[86px] flex items-center gap-3">
        {% if v.compare_at_price > v.price %}
          <span class="line-through opacity-60">
            {{ v.compare_at_price | money }}
          </span>
          <span>
            {{ v.price | money }}
          </span>
        {% else %}
          <span>
            {{ v.price | money }}
          </span>
        {% endif %}
      </div>

      {% if product.description != blank %}
        <div class="text-[14px] leading-[1.6] lg:mb-[55px]">
          {{ product.description }}
        </div>
      {% endif %}

      {% form 'product', product %}
        <!-- Quantity -->
        <div class="mt-20 mb-8 pb-8 border-b border-black">
          <div class="flex items-center justify-between">
            <label class="block text-[12px] font-normal uppercase tracking-[0.05em] mb-0">QUANTITY</label>
            <div class="flex items-center gap-6">
              <button
                type="button"
                class="bg-transparent border-0 w-auto h-auto flex items-center justify-center cursor-pointer text-[16px] transition-opacity duration-200 hover:opacity-60 p-0"
                data-action="decrease"
              >
                −
              </button>
              <input
                type="number"
                name="quantity"
                id="quantity"
                value="1"
                min="1"
                class="border-0 w-[60px] h-auto text-center text-[14px] bg-transparent p-0 focus:outline-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:m-0 [&::-webkit-inner-spin-button]:m-0"
              >
              <button
                type="button"
                class="bg-transparent border-0 w-auto h-auto flex items-center justify-center cursor-pointer text-[16px] transition-opacity duration-200 hover:opacity-60 p-0"
                data-action="increase"
              >
                +
              </button>
            </div>
          </div>
        </div>

        <!-- Size Selector (if product has variants) -->
        {% if product.variants.size > 1 %}
          <div class="mb-8 pb-4 flex justify-between items-center">
            <label class="block text-[12px] font-normal uppercase tracking-[0.05em] mb-0">SIZE</label>
            <select
              name="id"
              class="w-auto min-w-[200px] py-2 pr-8 pl-0 text-[16px] border-0 bg-transparent bg-[url('data:image/svg+xml,%3Csvg%20width=%2712%27%20height=%278%27%20viewBox=%270%200%2012%208%27%20fill=%27none%27%20xmlns=%27http://www.w3.org/2000/svg%27%3E%3Cpath%20d=%27M1%201L6%206L11%201%27%20stroke=%27black%27%20stroke-width=%272%27/%3E%3C/svg%3E')] bg-no-repeat bg-[right_center] cursor-pointer appearance-none focus:outline-none font-medium"
            >
              {% for variant in product.variants %}
                <option
                  value="{{ variant.id }}"
                  {% if variant.available %}
                  {% else %}
                    disabled
                  {% endif %}
                >
                  {{ variant.title }}
                  {% unless variant.available %}(Sold Out){% endunless %}
                </option>
              {% endfor %}
            </select>
          </div>
        {% else %}
          <input type="hidden" name="id" value="{{ product.variants.first.id }}">
        {% endif %}

        <!-- Add to Bag Button -->
        <button
          type="submit"
          class="w-full py-4 px-8 text-[14px] font-normal tracking-wide text-black border-1 border-b-black cursor-pointer transition-colors duration-200 hover:text-[#f6f5f1] hover:bg-black disabled:bg-[#ccc] disabled:cursor-not-allowed lg:mt-[55px]"
          {% unless product.available %}
            disabled
          {% endunless %}
        >
          {% if product.available %}
            Add to bag
          {% else %}
            Sold Out
          {% endif %}
        </button>
      {% endform %}
    </div>
  </div>
</section>

<style>
  .thumb-active {
    opacity: 1 !important;
  }
</style>

<script>
  (function () {
    const mainImage = document.getElementById('main-product-image');
    const mainPlaceholder = document.querySelector('[data-main-placeholder]');
    const thumbnails = document.querySelectorAll('[data-thumb-image]');
    const preloadedImages = new Map();

    // Handle main image load
    if (mainImage) {
      if (mainImage.complete) {
        handleMainImageLoad();
      } else {
        mainImage.addEventListener('load', handleMainImageLoad);
      }
    }

    function handleMainImageLoad() {
      mainImage.style.opacity = '1';
      if (mainPlaceholder) {
        setTimeout(() => {
          mainPlaceholder.style.opacity = '0';
        }, 100);
      }
    }

    // Handle thumbnail images load
    thumbnails.forEach(thumb => {
      if (thumb.complete) {
        handleThumbLoad(thumb);
      } else {
        thumb.addEventListener('load', function() {
          handleThumbLoad(thumb);
        });
      }
    });

    function handleThumbLoad(thumb) {
      thumb.style.opacity = '1';
      const placeholder = thumb.previousElementSibling;
      if (placeholder && placeholder.hasAttribute('data-thumb-placeholder')) {
        setTimeout(() => {
          placeholder.style.opacity = '0';
        }, 100);
      }
    }

    // Preload all full-size images in background for instant switching
    function preloadProductImages() {
      thumbnails.forEach((thumb) => {
        const fullSrc = thumb.dataset.src;
        const fullSrcset = thumb.dataset.srcset;

        if (fullSrc && !preloadedImages.has(fullSrc)) {
          const img = new Image();

          // Set srcset first for responsive loading
          if (fullSrcset) {
            img.srcset = fullSrcset;
            img.sizes = '(max-width: 768px) 100vw, 50vw';
          }
          img.src = fullSrc;

          // Store in cache
          preloadedImages.set(fullSrc, img);
        }
      });
    }

    // Start preloading after a short delay (after main image loads)
    setTimeout(preloadProductImages, 500);

    // Thumbnail click handler with instant switching
    if (mainImage && thumbnails.length) {
      thumbnails.forEach((thumb) => {
        thumb.parentElement.addEventListener('click', function () {
          const newSrc = thumb.dataset.src;
          const newSrcset = thumb.dataset.srcset;
          const newPlaceholderSrc = thumb.dataset.placeholderSrc;

          // Update main placeholder first (for smooth transition)
          if (newPlaceholderSrc && mainPlaceholder) {
            mainPlaceholder.src = newPlaceholderSrc;
            mainPlaceholder.style.opacity = '1';
          }

          // Update main image
          if (newSrc) mainImage.src = newSrc;
          if (newSrcset) mainImage.setAttribute('srcset', newSrcset);

          // Since image is preloaded, it should appear instantly
          // But we still handle the load event for browsers that might not cache
          if (preloadedImages.has(newSrc)) {
            // Image is cached, show immediately
            mainImage.style.opacity = '1';
            if (mainPlaceholder) {
              setTimeout(() => {
                mainPlaceholder.style.opacity = '0';
              }, 100);
            }
          } else {
            // Fallback: wait for load
            mainImage.style.opacity = '0';
            mainImage.onload = function() {
              mainImage.style.opacity = '1';
              if (mainPlaceholder) {
                setTimeout(() => {
                  mainPlaceholder.style.opacity = '0';
                }, 100);
              }
            };
          }

          // Update active state on thumbnails
          thumbnails.forEach((t) => {
            t.classList.remove('thumb-active');
          });
          thumb.classList.add('thumb-active');
        });
      });
    }

    // Quantity controls
    const qtyInput = document.getElementById('quantity');
    const qtyBtns = document.querySelectorAll('[data-action]');

    qtyBtns.forEach((btn) => {
      btn.addEventListener('click', function () {
        const currentValue = parseInt(qtyInput.value);
        if (this.dataset.action === 'increase') qtyInput.value = currentValue + 1;
        if (this.dataset.action === 'decrease' && currentValue > 1) qtyInput.value = currentValue - 1;
      });
    });
  })();
</script>

{% schema %}
{
  "name": "TF • Product Template",
  "settings": []
}
{% endschema %}