{% comment %} TF • Press List (Full Press Page) {% endcomment %}

{{ 'tf-press.css' | asset_url | stylesheet_tag }}

<section class="px-[20px] md:px-[30px] lg:px-[50px] flex flex-col" style="margin-top: 130px;" id="tf-press-list">
  <!-- Header -->
  <div class="mb-16 grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 xl:grid-cols-8 gap-[15px] md:gap-[20px] lg:gap-[40px] pb-8">
    <div class="col-span-2 md:col-span-2 lg:col-span-3 xl:col-span-4">
      <h2 class="font-sm uppercase">{{ section.settings.heading }}</h2>
    </div>
    <div class="col-span-2 md:col-span-2 lg:col-span-3 xl:col-span-4">
      <div class="font-sm leading-tight">{{ section.settings.description }}</div>
    </div>
  </div>

  {% comment %} Sort press articles by publication_date, newest first {% endcomment %}
  {%- capture date_handles -%}
    {%- for article in shop.metaobjects.press_article.values -%}
      {{- article.publication_date.value | default: '1970-01-01' -}}~{{- article.system.handle -}}
      {%- unless forloop.last -%}|{%- endunless -%}
    {%- endfor -%}
  {%- endcapture -%}
  {% assign sorted_entries = date_handles | split: '|' | sort | reverse %}

  {% comment %} Featured row — its own grid (lg:6, 2xl:8) {% endcomment %}
  <div class="w-full grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 2xl:grid-cols-8 auto-rows-min gap-x-[15px] gap-y-[42px] md:gap-[20px] lg:gap-[40px] mb-[42px] md:mb-0">
    {% for entry in sorted_entries limit: 2 %}
      {% assign sorted_handle = entry | split: '~' | last %}
      {% for article in shop.metaobjects.press_article.values %}
        {% if article.system.handle == sorted_handle %}
          {% render 'tf-press-card-featured', article: article %}
          {% break %}
        {% endif %}
      {% endfor %}
    {% endfor %}
  </div>

  {% comment %} Regular cards — curve-edit grid (lg:4, xl:8) {% endcomment %}
  {% assign items_per_page = section.settings.items_per_page %}
  <div class="w-full grid grid-cols-2 md:grid-cols-4 lg:grid-cols-4 xl:grid-cols-8 auto-rows-min gap-x-[15px] gap-y-[42px] md:gap-x-[20px] md:gap-y-[124px] lg:gap-x-[40px] lg:gap-y-[124px] pb-[60px]" id="tf-press-grid">
    {% assign index = 0 %}
    {% for entry in sorted_entries offset: 2 %}
      {% assign sorted_handle = entry | split: '~' | last %}
      {% for article in shop.metaobjects.press_article.values %}
        {% if article.system.handle == sorted_handle %}
          <div class="tf-press-grid-item col-span-1 md:col-span-1 lg:col-span-1 xl:col-span-2 flex flex-col{% if index >= items_per_page %} hidden{% endif %}">
            {% render 'tf-press-card', article: article %}
          </div>
          {% assign index = index | plus: 1 %}
          {% break %}
        {% endif %}
      {% endfor %}
    {% endfor %}
  </div>

  {% comment %} Load More button {% endcomment %}
  {% assign total = sorted_entries.size %}
  {% assign remaining = total | minus: 2 %}
  {% if remaining > items_per_page %}
    <div class="text-center pb-[60px]" id="tf-press-load-more-wrap">
      <button type="button" id="tf-press-load-more" class="font-sm underline text-black bg-transparent border-none cursor-pointer">
        Load More
      </button>
    </div>
  {% endif %}
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var pressImages = document.querySelectorAll('#tf-press-list [data-press-image]');
    pressImages.forEach(function (img) {
      if (img.complete) {
        handlePressImageLoad(img);
      } else {
        img.addEventListener('load', function () {
          handlePressImageLoad(img);
        });
      }
    });

    function handlePressImageLoad(img) {
      img.style.opacity = '1';
      var placeholder = img.previousElementSibling;
      if (placeholder && placeholder.hasAttribute('data-placeholder')) {
        setTimeout(function () {
          placeholder.style.opacity = '0';
        }, 100);
      }
    }

    var loadMoreBtn = document.getElementById('tf-press-load-more');
    var loadMoreWrap = document.getElementById('tf-press-load-more-wrap');
    if (loadMoreBtn) {
      var perPage = {{ section.settings.items_per_page }};
      var visible = perPage;
      var items = document.querySelectorAll('#tf-press-grid .tf-press-grid-item');

      loadMoreBtn.addEventListener('click', function () {
        var next = Math.min(visible + perPage, items.length);
        for (var i = visible; i < next; i++) {
          items[i].classList.remove('hidden');
        }
        visible = next;
        if (visible >= items.length) {
          loadMoreWrap.style.display = 'none';
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "TF • Press list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "PRESS"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "The Fall has been quietly reshaping the bridal conversation. A selection of press that captures our approach to modern dressing, independent retail, and the contemporary bride."
    },
    {
      "type": "range",
      "id": "items_per_page",
      "min": 4,
      "max": 24,
      "step": 4,
      "label": "Items shown before 'Load More'",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "TF • Press list"
    }
  ]
}
{% endschema %}
